{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "index-v2.html", "use": "@vercel/static" },
    { "src": "politica-de-privacidade.html", "use": "@vercel/static" },
    { "src": "termos-de-uso.html", "use": "@vercel/static" },
    { "src": "llms.txt", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/v2/?", "dest": "/index-v2.html" },
    { "src": "/politica-de-privacidade/?", "dest": "/politica-de-privacidade.html" },
    { "src": "/termos-de-uso/?", "dest": "/termos-de-uso.html" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
